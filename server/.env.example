# ── AI News server configuration ─────────────────────────────────────────
# EVERY setting lives in this env file (or as a GitHub Actions secret).
# Nothing is stored online. Copy to server/.env and fill in the values.

# ── Firebase datastore (REQUIRED — dedup, blogs, subscribers) ──────────
FIREBASE_PROJECT_ID=ai-news-f840e

# Paste the FULL service-account JSON here (one line), or base64-encode it.
# Get it: Firebase console → Project settings → Service accounts →
#         "Generate new private key"
FIREBASE_SERVICE_ACCOUNT=

# ── Email (Resend) ──────────────────────────────────────────────────────
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=ByteDaily <news@yourdomain.com>
RESEND_TEMPLATE_ID=

# ── Email (legacy SMTP — not used for sending) ─────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=

# ── Discord ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Schedule (used by the web server's APScheduler) ────────────────────
DIGEST_HOUR_IST=8
DIGEST_MINUTE_IST=0

# ── Firebase web-app config (public frontend values) ───────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=