# ── Firebase (server auth — REQUIRED) ───────────────────────────────
# Project ID: find it in Firebase console → Project settings → General
FIREBASE_PROJECT_ID=ai-news-f840e

# Paste the FULL service-account JSON here (one line), or base64-encode it.
# Get it: Firebase console → Project settings → Service accounts →
#         "Generate new private key"
# Example (replace with your own):
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "ai-news-f840e", ...}
FIREBASE_SERVICE_ACCOUNT=

# ── Firebase (web SDK config — kept for the future webApp) ─────────
FIREBASE_API_KEY=AIzaSyBCgNmCILvmmzr9XixtrphrbUHrf1ttUyM
FIREBASE_AUTH_DOMAIN=ai-news-f840e.firebaseapp.com
FIREBASE_STORAGE_BUCKET=ai-news-f840e.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1083227760007
FIREBASE_APP_ID=1:1083227760007:web:b44c670b88751463d79f22
FIREBASE_MEASUREMENT_ID=G-47972NMT63

# ── Email (SMTP) ──────────────────────────────────────────────────
# GMAIL_USER / GMAIL_APP_PASSWORD are your SMTP login credentials.
#   - Gmail: GMAIL_USER=you@gmail.com, GMAIL_APP_PASSWORD=16-char app password
#   - Brevo: GMAIL_USER=<your brevo login email>, GMAIL_APP_PASSWORD=<brevo SMTP key>
#            (Brevo → SMTP & API → SMTP key, then verify your sender domain)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SMTP endpoint — Brevo uses port 587 (STARTTLS); Gmail uses 465 (SSL)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# "From" address shown to recipients — set to your verified official email
EMAIL_FROM=hello@yourdomain.com

# Recipients are NOT configured here anymore — they come from the
# Firestore `users` collection (schema.json):
#   users/<user> -> { "name": "...", "email": "...", "timestamp": ... }
# Add subscriber docs there and the pipeline emails each one automatically.

# ── Discord ───────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# ── Schedule ──────────────────────────────────────────────────────
DIGEST_HOUR_IST=8
DIGEST_MINUTE_IST=0